{
  "name": "Gyra",
  "version": "0.1.0",
  "default_model": {
    "provider": "openai",
    "model_id": "gpt-4",
    "api_key": "",
    "temperature": 0.7,
    "max_tokens": 4096
  },
  "sandbox": {
    "enabled": false,
    "image": "python:3.11-slim",
    "memory_limit": "512m",
    "timeout": 300,
    "network_enabled": false
  },
  "oauth2": {
    "enabled": false,
    "providers": [],
    "admin_users": []
  },
  "feature_plugins": {
    "permissions": {
      "enabled": true
    }
  },
  "schema_migration": {
    "enabled": true,
    "upgrades_dir": "assets/schema/mysql/upgrades",
    "full_ddl_file": "assets/schema/mysql/gyra.sql",
    "baseline_existing_db": true,
    "on_error": "abort",
    "tolerate_duplicate": true,
    "lock_timeout_seconds": 30,
    "last_applied_script": "",
    "last_applied_at": ""
  },
  "workspace": "~/.gyra/workspace",
  "log_level": "INFO",
  "server": {
    "host": "127.0.0.1",
    "port": 8888
  }
}
